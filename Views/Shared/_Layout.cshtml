@inject IWebHostEnvironment HostEnvironment
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MessForecast</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web_ca_3.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">MessForecast</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index">My dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Operations" asp-action="Index">Operations</a>
                        </li>
                        @if (User.IsInRole("MessAdministrator") || User.IsInRole("SystemAdministrator") || User.IsInRole("Admin")) {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Admin</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-shell py-3">
        @if (HostEnvironment.IsDevelopment())
        {
            <div class="alert alert-info border-0 shadow-sm" role="note">
                <strong>Development demo accounts</strong>
                <span class="ms-2">Passwords are synchronized automatically on each Development startup.</span>
                <details class="mt-2">
                    <summary class="fw-semibold">Show credentials</summary>
                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-bordered mb-0 bg-white">
                            <thead><tr><th>Role</th><th>Email</th><th>Password</th></tr></thead>
                            <tbody>
                                <tr><td>Student</td><td>student@mess.local</td><td>Student123!</td></tr>
                                <tr><td>Kitchen Staff</td><td>kitchen@mess.local</td><td>Kitchen123!</td></tr>
                                <tr><td>Mess Manager</td><td>manager@mess.local</td><td>Manager123!</td></tr>
                                <tr><td>Mess Administrator</td><td>messadmin@mess.local</td><td>MessAdmin123!</td></tr>
                                <tr><td>Finance Officer</td><td>finance@mess.local</td><td>Finance123!</td></tr>
                                <tr><td>System Administrator</td><td>sysadmin@mess.local</td><td>SysAdmin123!</td></tr>
                            </tbody>
                        </table>
                    </div>
                </details>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - web_ca_3 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
