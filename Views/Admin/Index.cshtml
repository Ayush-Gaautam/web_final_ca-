@model web_ca_3.Controllers.AdminViewModel
@{ ViewData["Title"] = "Administration"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="display-6 fw-bold">Administration</h1><p class="text-muted">Manage accounts, access, and dining halls.</p></div><span class="badge text-bg-danger">Admin only</span></div>
<div class="row g-4">
<div class="col-lg-7"><div class="card shadow-sm border-0"><div class="card-body"><h5>Users and access</h5><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Email</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var user in Model.Users) { <tr><td>@user.Email</td><td>@(user.LockoutEnd > DateTimeOffset.UtcNow ? "Disabled" : "Active")</td><td><form asp-action="DisableUser" method="post"><input type="hidden" name="id" value="@user.Id" /><button class="btn btn-sm btn-outline-danger">Disable</button></form></td></tr> }</tbody></table></div></div></div></div>
<div class="col-lg-5"><div class="card shadow-sm border-0"><div class="card-body"><h5>Add dining hall</h5><form asp-action="AddHall" method="post" class="row g-2"><div class="col-7"><input name="Name" class="form-control" placeholder="Hall name" required /></div><div class="col-5"><input name="Capacity" type="number" min="1" class="form-control" placeholder="Capacity" required /></div><div class="col-12"><button class="btn btn-primary w-100">Save hall</button></div></form><hr /><ul class="list-group list-group-flush">@foreach (var hall in Model.Halls) { <li class="list-group-item d-flex justify-content-between"><span>@hall.Name</span><span class="badge text-bg-light">@hall.Capacity</span></li> }</ul></div></div></div>
</div>
