@model web_ca_3.Controllers.OperationsViewModel
@{
    ViewData["Title"] = "Operations";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div><h1 class="display-6 fw-bold">Operations</h1><p class="text-muted mb-0">Manage the master data and service records used by forecasting.</p></div>
    <a class="btn btn-primary btn-lg" href="/api/forecast">Open forecast</a>
</div>
@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (User.IsInRole("Student")) {
<div class="card shadow-sm border-0 mb-4"><div class="card-body"><h5>Book a meal</h5><form asp-action="BookMeal" method="post" class="row g-2 align-items-end">
    <div class="col-md-4"><label class="form-label">Date</label><input name="BookingDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
    <div class="col-md-4"><label class="form-label">Meal</label><select name="Meal" class="form-select"><option value="0">Breakfast</option><option value="1">Lunch</option><option value="2">Dinner</option><option value="3">Snack</option></select></div>
    <div class="col-md-4"><button class="btn btn-success w-100">Book meal</button></div>
</form><div class="mt-3">@if (Model.Bookings.Any()) { <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Date</th><th>Meal</th><th></th></tr></thead><tbody>@foreach (var booking in Model.Bookings) { <tr><td>@booking.BookingDate.ToString("dd MMM yyyy")</td><td>@booking.Meal</td><td><form asp-action="CancelMeal" method="post"><input type="hidden" name="id" value="@booking.Id" /><button class="btn btn-sm btn-outline-danger">Cancel</button></form></td></tr> }</tbody></table></div> } else { <div class="alert alert-light mb-0">No upcoming bookings.</div> }</div></div></div>
}
@if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff") || User.IsInRole("KitchenStaff")) {
<div class="row g-3 mb-4">
<div class="col-lg-6"><div class="card shadow-sm border-0"><div class="card-body"><h5>Add dish</h5><form asp-action="AddDish" method="post" class="row g-2"><div class="col-6"><input name="Name" class="form-control" placeholder="Dish name" required /></div><div class="col-3"><input name="Category" class="form-control" value="Main" /></div><div class="col-3"><input name="Calories" type="number" min="0" class="form-control" placeholder="Calories" /></div><div class="col-12"><button class="btn btn-primary">Save dish</button></div></form></div></div></div>
<div class="col-lg-6"><div class="card shadow-sm border-0"><div class="card-body"><h5>Add ingredient</h5><form asp-action="AddIngredient" method="post" class="row g-2"><div class="col-5"><input name="Name" class="form-control" placeholder="Ingredient" required /></div><div class="col-2"><input name="Unit" class="form-control" value="kg" /></div><div class="col-2"><input name="UnitCost" type="number" step="0.01" min="0" class="form-control" placeholder="Cost" /></div><div class="col-3"><input name="CurrentStock" type="number" step="0.01" min="0" class="form-control" placeholder="Stock" /></div><div class="col-12"><button class="btn btn-primary">Save ingredient</button></div></form></div></div></div>
<div class="col-lg-6"><div class="card shadow-sm border-0"><div class="card-body"><h5>Capture attendance</h5><form asp-action="AddAttendance" method="post" class="row g-2"><div class="col-4"><input name="ServiceDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div><div class="col-3"><select name="Meal" class="form-select"><option value="0">Breakfast</option><option value="1">Lunch</option><option value="2">Dinner</option><option value="3">Snack</option></select></div><div class="col-2"><input name="ExpectedCount" type="number" min="0" class="form-control" placeholder="Expected" /></div><div class="col-3"><input name="ActualCount" type="number" min="0" class="form-control" placeholder="Actual" /></div><div class="col-12"><button class="btn btn-success">Save attendance</button></div></form></div></div></div>
</div>
}
<div class="row g-4">
    <div class="col-lg-6"><div class="card shadow-sm border-0"><div class="card-body"><h5>Menu dishes <span class="badge text-bg-light">@Model.Dishes.Count</span></h5><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Category</th><th>Calories</th><th>Status</th></tr></thead><tbody>@foreach (var dish in Model.Dishes) { <tr><td>@dish.Name</td><td>@dish.Category</td><td>@dish.Calories</td><td><span class="badge text-bg-success">Active</span></td></tr> }</tbody></table></div></div></div></div>
    <div class="col-lg-6"><div class="card shadow-sm border-0"><div class="card-body"><h5>Ingredient stock <span class="badge text-bg-light">@Model.Ingredients.Count</span></h5><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Stock</th><th>Unit cost</th><th>Value</th></tr></thead><tbody>@foreach (var ingredient in Model.Ingredients) { <tr><td>@ingredient.Name</td><td>@ingredient.CurrentStock @ingredient.Unit</td><td>₹@ingredient.UnitCost.ToString("N2")</td><td>₹@( (ingredient.CurrentStock * ingredient.UnitCost).ToString("N2") )</td></tr> }</tbody></table></div></div></div></div>
    <div class="col-12"><div class="card shadow-sm border-0"><div class="card-body"><h5>Recent attendance</h5><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Date</th><th>Meal</th><th>Expected</th><th>Actual</th><th>Variance</th></tr></thead><tbody>@foreach (var item in Model.Attendance) { <tr><td>@item.ServiceDate.ToString("dd MMM yyyy")</td><td>@item.Meal</td><td>@item.ExpectedCount</td><td>@item.ActualCount</td><td class="@(item.ActualCount <= item.ExpectedCount ? "text-success" : "text-danger")">@(@item.ActualCount - item.ExpectedCount)</td></tr> }</tbody></table></div></div></div></div>
</div>
