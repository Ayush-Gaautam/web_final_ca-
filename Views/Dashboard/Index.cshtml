@model web_ca_3.Controllers.DashboardViewModel
@using web_ca_3.Models
@inject web_ca_3.Data.ApplicationDbContext Db
@{
    ViewData["Title"] = "Mess operations dashboard";
    var ingredients = Db.Ingredients.OrderBy(x => x.Name).ToList();
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="display-6 fw-bold">Mess operations</h1><p class="text-muted mb-0">Demand, preparation and food-waste control in one place.</p></div>
    <span class="badge text-bg-success px-3 py-2">Live planning</span>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card shadow-sm border-0"><div class="card-body"><div class="text-muted">Today's lunch forecast</div><div class="display-6 fw-bold">@Model.TodayForecast</div><small>servings</small></div></div></div>
    <div class="col-md-3"><div class="card shadow-sm border-0"><div class="card-body"><div class="text-muted">Active dishes</div><div class="display-6 fw-bold">@Model.ActiveDishes</div><small>menu items</small></div></div></div>
    <div class="col-md-3"><div class="card shadow-sm border-0"><div class="card-body"><div class="text-muted">Ingredient stock value</div><div class="display-6 fw-bold">₹@Model.IngredientValue.ToString("N0")</div><small>current inventory</small></div></div></div>
    <div class="col-md-3"><div class="card shadow-sm border-0"><div class="card-body"><div class="text-muted">Waste this month</div><div class="display-6 fw-bold text-danger">₹@Model.WasteCostThisMonth.ToString("N0")</div><small>cost exposure</small></div></div></div>
</div>
<div class="row g-4">
    <div class="col-lg-7"><div class="card shadow-sm border-0"><div class="card-body"><h5>Record waste</h5><form asp-action="AddWaste" method="post" class="row g-2">
        <div class="col-md-5"><select name="IngredientId" class="form-select"><option value="">Ingredient</option>@foreach (var item in ingredients) { <option value="@item.Id">@item.Name (@item.Unit)</option> }</select></div>
        <div class="col-md-2"><input name="Quantity" class="form-control" type="number" step="0.001" min="0" placeholder="Qty" required /></div>
        <div class="col-md-3"><select name="Reason" class="form-select">@foreach (var reason in Enum.GetValues<WasteReason>()) { <option value="@reason">@reason</option> }</select></div>
        <div class="col-md-2"><button class="btn btn-danger w-100">Save</button></div>
    </form></div></div>
    <div class="card shadow-sm border-0 mt-4"><div class="card-body"><h5>Recent waste events</h5><table class="table table-sm"><thead><tr><th>Date</th><th>Item</th><th>Reason</th><th>Cost</th></tr></thead><tbody>@foreach (var item in Model.RecentWaste) { <tr><td>@item.WasteDate.ToString("dd MMM")</td><td>@(item.Ingredient?.Name ?? item.MenuDish?.Name ?? "General")</td><td>@item.Reason</td><td>₹@item.Cost.ToString("N2")</td></tr> }</tbody></table></div></div></div>
    <div class="col-lg-5"><div class="card shadow-sm border-0"><div class="card-body"><h5>Planning shortcuts</h5><p class="text-muted">Use the REST API from a mobile attendance capture app or integrate with a kitchen display.</p><div class="d-grid gap-2"><a class="btn btn-outline-primary" href="/api/forecast">View forecast API</a><a class="btn btn-outline-secondary" href="/api/dishes">View dishes API</a><a class="btn btn-outline-secondary" href="/api/waste-summary">View waste report API</a></div></div></div></div>
</div>
